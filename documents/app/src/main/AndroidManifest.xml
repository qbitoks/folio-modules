<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reports the reading page to Folio (signature permission defined by Folio). -->
    <uses-permission android:name="app.folio.permission.READING" />

    <queries>
        <package android:name="app.folio" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_module"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.FolioPdf">

        <!-- Opened only by Folio: no launcher icon. -->
        <activity
            android:name=".PdfActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="app.folio.action.OPEN_PDF" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/vnd.djvu" />
                <data android:mimeType="image/x-djvu" />
            </intent-filter>
        </activity>
    </application>
</manifest>
